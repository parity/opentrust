# The settings file for the server: /etc/opentrust/opentrust.env  (root-owned, readable by deployer: chmod 640, chgrp deployer).
# Outside the repository on purpose. One KEY=value per line. Generate secrets with the commands in deploy/droplet/README.md.
# Use hex for the database passwords (openssl rand -hex 24) so they are safe inside URLs.

# How traffic gets in: "tunnel" = Cloudflare Tunnel (recommended, no open web ports) or "caddy" (this server serves HTTPS itself).
ENTRY=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Run the Shopify app on this server too? (yes/no). Needs the Shopify values below.
RUN_SHOPIFY=no

# Where the DigitalOcean Volume is mounted. The database files live in $DATA_DIR/postgres
DATA_DIR=/mnt/opentrust_data

# Database passwords (the logins are created the first time the database starts)
POSTGRES_PASSWORD=
OPENTRUST_DB_PASSWORD=
SHOPIFY_DB_PASSWORD=

# Domains. With "tunnel" they are set in the Cloudflare dashboard; with "caddy" DNS must point at this server.
APP_DOMAIN=opentrust.in
SHOPIFY_DOMAIN=shopify.opentrust.in

# Website and API (same settings as docs/DEPLOYMENT.md section 3)
SECRET_KEY_BASE=
PHONE_HASH_PEPPER=
AR_ENC_PRIMARY_KEY=
AR_ENC_DETERMINISTIC_KEY=
AR_ENC_SALT=
RESEND_API_KEY=
APP_HOST=opentrust.in
MAIL_FROM="OpenTrust <noreply@opentrust.in>"

# Shopify app (only if RUN_SHOPIFY=yes)
SHOPIFY_APP_URL=https://shopify.opentrust.in
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
ENCRYPTION_KEY=

# Backups: days of dumps to keep locally, and the script that copies each dump off the server (see backup.sh)
BACKUP_KEEP_DAYS=14
BACKUP_UPLOAD_CMD=

# Only for a second deployment on the same server, such as staging (see deploy/droplet/README.md, "A second environment"). Leave unset for production.
# COMPOSE_PROJECT_NAME=opentrust-staging
# DEPLOY_BRANCH=staging
# NOINDEX=true
