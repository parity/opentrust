# Copy these into your hosting platform's environment settings. Never commit real values.
# Generate secrets with the commands in docs/DEPLOYMENT.md.

# Required
SECRET_KEY_BASE=
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/opentrust_production
PHONE_HASH_PEPPER=
AR_ENC_PRIMARY_KEY=
AR_ENC_DETERMINISTIC_KEY=
AR_ENC_SALT=
RESEND_API_KEY=
APP_HOST=opentrust.in

# Required once, to seed the first admin (then remove the password from the environment)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email
MAIL_FROM="OpenTrust <noreply@opentrust.in>"

# Optional
FEEDBACK_EMAIL=feedback@opentrust.in
GRIEVANCE_EMAIL=grievance@opentrust.in
OPERATOR_NAME="Parity Cube Pvt Ltd"
OPERATOR_ADDRESS="D/6 Goragandhi, Opp Railway Station, Chandavarkar Road, Borivali West, Mumbai 400091"
GRIEVANCE_OFFICER_NAME="Jimish Jobanputra"
GRIEVANCE_OFFICER_DESIGNATION="Co-Founder"
GRIEVANCE_OFFICER_ADDRESS="Borivali West, Mumbai"
COFFEE_URL=
REPO_URL=
SDKS_PUBLISHED=false
RAILS_LOG_LEVEL=info
