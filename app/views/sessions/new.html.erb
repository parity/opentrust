<% content_for :title, "Log in" %>
<div class="mx-auto max-w-sm">
  <h1 class="text-3xl font-bold tracking-tight">Log in</h1>
  <%= form_with url: login_path, class: "card mt-6 space-y-4" do %>
    <div><%= label_tag :email, "Email", class: "label" %><%= email_field_tag :email, nil, required: true, autocomplete: "email", class: "field" %></div>
    <div><%= label_tag :password, "Password", class: "label" %><%= password_field_tag :password, nil, required: true, autocomplete: "current-password", class: "field" %></div>
    <%= submit_tag "Log in", class: "btn w-full" %>
  <% end %>
  <p class="mt-4 text-sm text-ink-soft">New here? <%= link_to "Register your business", register_path, class: "text-blue underline" %></p>
</div>
