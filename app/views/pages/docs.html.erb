result.reports;      // what other merchants noted
result.notice;       // keep this in front of anyone who sees the result</code></pre><% end %><pre data-tabs-target="panel"><code>const res = await fetch(&quot;https://opentrust.in/api/v1/lookups&quot;, {
  method: &quot;POST&quot;,
  headers: {
    Authorization: `Bearer ${process.env.OPENTRUST_KEY}`,
    &quot;Content-Type&quot;: &quot;application/json&quot;,
  },
  body: JSON.stringify({ phone: &quot;9876543210&quot; }),
});
const result = await res.json();</code></pre><pre data-tabs-target="panel"><code>import os, requests

res = requests.post(
    &quot;https://opentrust.in/api/v1/lookups&quot;,
    headers={&quot;Authorization&quot;: f&quot;Bearer {os.environ[&#x27;OPENTRUST_KEY&#x27;]}&quot;},
    json={&quot;phone&quot;: &quot;9876543210&quot;},
)
result = res.json()</code></pre><pre data-tabs-target="panel"><code>$ch = curl_init(&quot;https://opentrust.in/api/v1/lookups&quot;);
curl_setopt_array($ch, [
  CURLOPT_POST =&gt; true,
  CURLOPT_HTTPHEADER =&gt; [&quot;Authorization: Bearer &quot; . getenv(&quot;OPENTRUST_KEY&quot;),
                         &quot;Content-Type: application/json&quot;],
  CURLOPT_POSTFIELDS =&gt; json_encode([&quot;phone&quot; =&gt; &quot;9876543210&quot;]),
  CURLOPT_RETURNTRANSFER =&gt; true,
]);
$result = json_decode(curl_exec($ch), true);</code></pre><pre data-tabs-target="panel"><code>require &quot;net/http&quot;
require &quot;json&quot;

uri = URI(&quot;https://opentrust.in/api/v1/lookups&quot;)
req = Net::HTTP::Post.new(uri, &quot;Authorization&quot; =&gt; &quot;Bearer #{ENV[&#x27;OPENTRUST_KEY&#x27;]}&quot;,
                               &quot;Content-Type&quot; =&gt; &quot;application/json&quot;)
req.body = { phone: &quot;9876543210&quot; }.to_json
res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }
result = JSON.parse(res.body)</code></pre>
      </div>
      <p class="mt-6"><strong>Or send a hash, so we never receive the number.</strong> The number is hashed on your side and we match on the hash (<a href="#hashing" class="text-blue underline">how, and what a hash does and doesn't do</a>). The format is exact, so you also send <span class="code">phone_length</span>, the length of the text you hashed, which is always <span class="code">13</span>. The libraries do all of it for you, and the other examples spell it out.</p>
      <div class="codeblock mt-2" data-controller="tabs">
        <div class="codeblock-bar" role="tablist"><button type="button" role="tab" class="codetab" data-tabs-target="tab" data-action="tabs#pick">curl</button><% if OpenTrust::SDKS_PUBLISHED %><button type="button" role="tab" class="codetab" data-tabs-target="tab" data-action="tabs#pick">Ruby gem</button><button type="button" role="tab" class="codetab" data-tabs-target="tab" data-action="tabs#pick">Node package</button><% end %><button type="button" role="tab" class="codetab" data-tabs-target="tab" data-action="tabs#pick">Node (fetch)</button><button type="button" role="tab" class="codetab" data-tabs-target="tab" data-action="tabs#pick">Python</button><button type="button" role="tab" class="codetab" data-tabs-target="tab" data-action="tabs#pick">PHP</button><button type="button" role="tab" class="codetab" data-tabs-target="tab" data-action="tabs#pick">Ruby (net/http)</button></div>
        <pre data-tabs-target="panel"><code># phone_sha256 is the SHA-256 of &quot;+91&quot; and the ten digits, as lowercase hex
NUMBER='+919876543210'
HASH=$(printf '%s' &quot;$NUMBER&quot; | shasum -a 256 | cut -d' ' -f1)
curl -X POST https://opentrust.in/api/v1/lookups \
  -H &quot;Authorization: Bearer $OPENTRUST_KEY&quot; \
  -d phone_sha256=$HASH \
  -d phone_length=${#NUMBER}   # 13: the length of the text you hashed</code></pre><% if OpenTrust::SDKS_PUBLISHED %><pre data-tabs-target="panel"><code>client = OpenTrust::Client.new(hash_numbers: true)
result = client.lookup(&quot;98765 43210&quot;) # sends only the hash and its length, never the number</code></pre><pre data-tabs-target="panel"><code>const ot = new OpenTrust({ hashNumbers: true });
const result = await ot.lookup(&quot;98765 43210&quot;); // sends only the hash and its length, never the number</code></pre><% end %><pre data-tabs-target="panel"><code>import { createHash } from &quot;node:crypto&quot;;

function normalize(raw) {
  let d = String(raw).replace(/\D/g, &quot;&quot;);
  if (d.length === 12 &amp;&amp; d.startsWith(&quot;91&quot;)) d = d.slice(2);
  if (d.length === 11 &amp;&amp; d.startsWith(&quot;0&quot;)) d = d.slice(1);
  if (!/^[6-9]\d{9}$/.test(d)) throw new Error(&quot;not an Indian mobile number&quot;);
  return &quot;+91&quot; + d;
}

const number = normalize(&quot;98765 43210&quot;);   // &quot;+919876543210&quot;
const res = await fetch(&quot;https://opentrust.in/api/v1/lookups&quot;, {
  method: &quot;POST&quot;,
  headers: {
    Authorization: `Bearer ${process.env.OPENTRUST_KEY}`,
    &quot;Content-Type&quot;: &quot;application/json&quot;,
  },
  body: JSON.stringify({
    phone_sha256: createHash(&quot;sha256&quot;).update(number).digest(&quot;hex&quot;),
    phone_length: number.length,   // 13: the length of the text you hashed
  }),
});
const result = await res.json();</code></pre><pre data-tabs-target="panel"><code>import hashlib, os, re, requests

def normalize(raw):
    d = re.sub(r&quot;\D&quot;, &quot;&quot;, raw)
    if len(d) == 12 and d.startswith(&quot;91&quot;): d = d[2:]
    if len(d) == 11 and d.startswith(&quot;0&quot;): d = d[1:]
