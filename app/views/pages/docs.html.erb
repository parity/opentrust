result = res.json()</code></pre><pre data-tabs-target="panel"><code>&lt;?php
function normalize($raw) {
    $d = preg_replace('/\D/', '', $raw);
    if (strlen($d) === 12 &amp;&amp; strpos($d, '91') === 0) $d = substr($d, 2);
