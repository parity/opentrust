    &quot;https://opentrust.in/api/v1/lookups&quot;,
    headers={&quot;Authorization&quot;: f&quot;Bearer {os.environ['OPENTRUST_KEY']}&quot;},
    json={
        &quot;phone_sha256&quot;: hashlib.sha256(number.encode()).hexdigest(),
        &quot;phone_length&quot;: len(number),   # 13: the length of the text you hashed
    },
