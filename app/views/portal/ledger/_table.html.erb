<div class="mt-3 overflow-x-auto"><table class="w-full text-left text-sm">
  <thead class="text-xs uppercase tracking-wide text-ink-soft"><tr><th class="py-2">When</th><th>Reason</th><th class="text-right">Checks</th><th class="text-right">Balance</th></tr></thead>
  <tbody class="divide-y divide-ink/20">
    <% entries.each do |e| %>
      <tr><td class="py-2"><%= l e.created_at, format: :short %></td><td><%= e.reason.humanize %> <span class="text-ink-soft"><%= e.memo %></span></td>
      <td class="data text-right <%= e.delta.negative? ? 'text-amber' : 'text-teal' %>"><%= '%+d' % e.delta %></td><td class="data text-right"><%= number_with_delimiter(e.balance_after) %></td></tr>
    <% end %>
    <% if entries.empty? %><tr><td colspan="4" class="py-4 text-ink-soft">No activity yet.</td></tr><% end %>
  </tbody></table></div>
